{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "gatraloca/backend",
  "type": "project",
  "description": "Laravel API backend for Gatraloca",
  "require": {"php": "^8.3", "laravel/framework": "^13.0"},
  "autoload": {"psr-4": {"App\\": "app/", "Database\\Factories\\": "database/factories/", "Database\\Seeders\\": "database/seeders/"}},
  "autoload-dev": {"psr-4": {"Tests\\": "tests/"}},
  "scripts": {"post-autoload-dump": ["Illuminate\\Foundation\\ComposerScripts::postAutoloadDump", "@php artisan package:discover --ansi"], "dev": "php artisan serve --host=0.0.0.0"},
  "config": {"optimize-autoloader": true, "preferred-install": "dist", "sort-packages": true, "allow-plugins": {"php-http/discovery": true}},
  "minimum-stability": "stable", "prefer-stable": true
}
